# Production uses Turso. Local development uses SQLite unless you opt into Turso below.
TURSO_DATABASE_URL=libsql://finger-elyxkik.aws-eu-central-1.turso.io
TURSO_AUTH_TOKEN=
USE_TURSO_IN_DEVELOPMENT=false

# Generate independent random secrets for encryption and session lookups.
PII_ENCRYPTION_KEY=
AUTH_SECRET=

# Optional live search; scans still include the curated website catalog without it.
BRAVE_SEARCH_API_KEY=

# Optional email sign-in links through Resend.
RESEND_API_KEY=
EMAIL_FROM="FingerprintScanner <noreply@example.com>"
APP_URL=http://localhost:3000

# Chariow checkout integration. Add published license products priced at $199/$299 USD,
# with one-year validity. Renewals are manual; service/coaching offers may not support API checkout.
CHARIOW_API_KEY=
CHARIOW_GUIDED_PRODUCT_ID=
CHARIOW_COMPLETE_PRODUCT_ID=
CHARIOW_PULSE_SECRET=
