APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./fingerprintscanner.db
REDIS_URL=redis://localhost:6379/0
# Generate a Fernet key; keep it stable and private.
PII_ENCRYPTION_KEY=
# Real scans require Brave Search API credentials. Empty means no live scan.
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:3010,http://localhost:3010
DATA_RETENTION_DAYS=30
# Optional. Search titles/snippets may contain personal data; enabling this sends them to the provider.
AI_PROVIDER=rules
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
MAGIC_LINK_SECRET=replace-with-a-long-random-secret
FRONTEND_BASE_URL=http://127.0.0.1:3010
# Local mode prints links in the API terminal. Configure a mail sender for deployed use.
EMAIL_DELIVERY_MODE=console
